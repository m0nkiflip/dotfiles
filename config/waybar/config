{
    "layer": "top",
    "height": 28,
    "modules-left":
    [
    	"custom/void",
        "ext/workspaces",
        "dwl/window"
    ],
    "modules-center":
    [
        "clock"
    ],
    "modules-right":
    [
    	"tray",
        "idle_inhibitor",
        "bluetooth",
        "network",
        "pulseaudio#outputDevice",
        "backlight",
        "battery"
    ],

    "ext/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": " {icon} ",
        "format-icons": {
            "active": "󰮯",
            "default": "󰊠"
        }
    },

    "custom/void":{ 
    	"format": "  ",
    		"tooltip": false,
    	"on-click": "~/.local/bin/fuzzel-powermenu"
    },

	"dwl/window": {
	    "format": "[ ~ {app_id}]",
	    "max-length": 15
	},
	
    "tray":
    {
        "icon-size": 21,
        "spacing": 10
    },

    "idle_inhibitor": {
        "tooltip-format-activated": "Active",
        "tooltip-format-deactivated": "Not active",
        "format": "{icon}",
        "format-icons": {
            "activated": " ",
            "deactivated": " ",
        }
    },
    
	"bluetooth": {
		"format": "󰂯",
		"format-connected": "󰂱",
		"tooltip-format-connected": "{source_desc}",
		"format-disabled": "󰂲",
		"on-click": "foot -e bluetui"
	},
	
    "clock": {
        "format": "{:%d %B - %I:%M %p}",
        "tooltip": false
    },

    "pulseaudio#outputDevice":
    {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon} 󰂰 {volume}%",
        "format-muted": "󰖁",
        "format-icons":
        {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default":
            [
                "", "", "󰕾",  ""
            ],
        },
/*        "tooltip-format": "{desc}", */

        "on-click": "foot -e wiremix"
    },

    "pulseaudio#inputDevice": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "tooltip-format": "{source_desc}",

        "on-click": "foot -e wiremix"
    },

    "network":
    {
        "format-wifi": "{icon}",
        "format-disconnected": "󰤮 ",
        "format-disabled": "󰤫 ",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP address: {ipaddr}\nGateway address: {gwaddr}\nSubnetmask: {netmask}",
        "tooltip-format-wifi": "SSID: {essid}\nIP address: {ipaddr}\nGateway address: {gwaddr}\nSubnetmask: {netmask}",
        "on-click": "foot -e impala",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "]
    },

    "cpu":
    {
        "format": " {usage}% ",
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        // Click izquierdo: 1% | Click derecho: 50% | Clic central: 100%
        "on-click": "brightnessctl -d intel_backlight set 1%",
        "on-click-right": "brightnessctl -d intel_backlight set 50%",
        "on-click-middle": "brightnessctl -d intel_backlight set 100%",
        "tooltip": false,
    },
    
