{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/Downloads/void2.png",
    "height": 14,
    "width": 36,
    "color": { "1": "green" },
    "padding": {
      "top": 3,
      "right": 4,
      "left": 4
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "custom",
      "key": " PC",
      "format": "(Thinkpad X13 Gen 2i)",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": "│ ├",
      "format": "11th Gen Intel® Core™ i7-1185G7 @ 4.8 Ghz",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green"
    },
    {
      "type": "swap",
      "key": "└ └󰓡 ",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "OS",
      "key": " OS",
      "keyColor": "cyan",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "cyan",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\""
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "cyan",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "cyan"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "cyan"
    },
    {
      "type": "erminalfont",
      "key": "└ └",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Age / Uptime / Update───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "magenta",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "magenta"
    },
	{
    	"type": "command",
    	"key": " Update",
    	"keyColor": "magenta",
    	"text": "date -r /var/db/xbps '+%d %b - %I:%M %p'"
	},
    {
      "type": "command",
      "key": " Update",
      "keyColor": "magenta",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
