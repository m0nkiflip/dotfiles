{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"type": "chafa",
        "source": "/home/mario/Downloads/void2.png",
		"width": 25,
		"height": 8,
        "color": {
		    "1": "green"
	},
        "padding": {
            "top": 2,
            "left": 2,
            "right": 3
        }
    },
    "modules": [
	"break",
	"break",
	{
            "type": "os",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "keyColor": "green"
        },
        {
        	"type": "wm",
        	"keyColor": "green"
        },
        {
            "type": "cpu",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "keyColor": "green",
            "format": "{pretty-name} {version} {#37}█{#97}█ {#36}█{#96}█ {#35}█{#95}█ {#34}█{#94}█ {#33}█{#93}█ {#32}█{#92}█ {#31}█{#91}█"
        }
    ]
}
