{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/2.66.0/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    },
    "source": "void2_small"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    "title",
    {
      "type": "os",
      "key": "os    ",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "green"
    },
    {
      "type": "host",
      "format": "{vendor} {family}",
      "key": "host  ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "pkgs  ",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m",
      "key": "uptime",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "memory",
      "keyColor": "cyan"
    },
    "break"
  ]
}
